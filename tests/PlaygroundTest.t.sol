pragma solidity 0.8.29;

import { Test } from "forge-std/src/Test.sol";

contract PlaygroundTest is Test {
    address internal constant INTUITION_ADMIN_SAFE = 0xbeA18ab4c83a12be25f8AA8A10D8747A07Cdc6eb;
    address internal constant INTUITION_UPGRADES_TIMELOCK = 0x321e5d4b20158648dFd1f360A79CAFc97190bAd1;

    address internal constant BASE_ADMIN_SAFE = 0xCa66d181c76eAE6439B90Fb5f73bF6252107AE4E;
    address internal constant BASE_UPGRADES_TIMELOCK = 0x1E442BbB08c98100b18fa830a88E8A57b5dF9157;

    function test_executeIntuitionScheduledUpgradeCalldata() external {
        vm.createSelectFork("intuition");
        vm.warp(block.timestamp + 7 days);

        vm.startPrank(INTUITION_ADMIN_SAFE);

        (bool trustBondingSuccess,) = INTUITION_UPGRADES_TIMELOCK.call(
            hex""
        );
        assertTrue(trustBondingSuccess);

        (bool offsetProgressiveCurveSuccess,) = INTUITION_UPGRADES_TIMELOCK.call(
            hex""
        );
        assertTrue(offsetProgressiveCurveSuccess);

        (bool satelliteEmissionsControllerSuccess,) = INTUITION_UPGRADES_TIMELOCK.call(
            hex""
        );
        assertTrue(satelliteEmissionsControllerSuccess);

        (bool atomWalletSuccess,) = INTUITION_UPGRADES_TIMELOCK.call(
            hex""
        );
        assertTrue(atomWalletSuccess);

        vm.stopPrank();
    }

    function test_executeBaseScheduledUpgradeCalldata() external {
        vm.createSelectFork("base");
        vm.warp(block.timestamp + 7 days);

        vm.startPrank(BASE_ADMIN_SAFE);

        (bool success,) = BASE_UPGRADES_TIMELOCK.call(
            hex""
        );
        assertTrue(success);

        vm.stopPrank();
    }
}
